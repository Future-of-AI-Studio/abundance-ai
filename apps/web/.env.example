# Frontend env. Only publishable values here — never secret keys.
# Leave VITE_SUPABASE_URL empty (or set VITE_USE_MOCKS=true) to run fully on the
# in-memory mock adapter.

VITE_USE_MOCKS=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

VITE_GUIDES_BUCKET_URL=
VITE_ENVIRONMENT=production

# Landing-page footer "Stay Updated" capture. The /exec URL of the Apps Script
# web app in scripts/subscribe-sheet.gs, which appends each signup to the
# monitoring Google Sheet. Leave empty in local dev — submissions are logged to
# the console instead. Empty in a PRODUCTION build makes the form show an error
# rather than silently dropping the lead.
VITE_SUBSCRIBE_URL=
