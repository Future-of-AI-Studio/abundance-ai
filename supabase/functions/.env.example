# Secrets for Edge Functions. Copy to `.env` for local `supabase functions serve`,
# and set the same keys with `supabase secrets set` for deploys. NEVER commit .env.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically in deployed functions; set them here only for local serve.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Public app origin (CORS + Stripe redirect URLs)
APP_URL=http://localhost:5173

# Stripe (test mode for judges)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Gemini via Vertex AI (Google Cloud). Leave SA_KEY empty locally to use the
# deterministic mock; set all four to make real Gemini calls.
GOOGLE_VERTEX_PROJECT_ID=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.0-flash-001
# Paste the full service-account JSON on one line (escaped) or use `supabase secrets set --env-file`.
GOOGLE_VERTEX_SA_KEY={"type":"service_account","project_id":"..."}
